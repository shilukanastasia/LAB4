#include <iostream>
#include <clocale>
using namespace std;
int main()
{
    setlocale(LC_ALL, "Russian");
    int T, a, s = 0, k = 0;
    cout << "Введите цель повторений (20-100): ";
    cin >> T;
    if (T < 20 || T > 100)
    {
        cout << "Ошибка ввода";
        return 0;
    }
    do
    {
        cout << "Введите количество повторений (1-20): ";
        cin >> a;
        if (a >= 1 && a <= 20)
        {
            s = s + a;
            k = k + 1;
        }
        else
        {
            cout << "Недопустимое значение. Повторите ввод." << endl;
        }
    }
    while (s < T);
    cout << "Количество подходов: " << k << endl;
    cout << "Итоговое количество повторений: " << s << endl;
    cout << "Превышение над целью: " << s - T << endl;
    return 0;
}
