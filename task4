#include <iostream>
#include <clocale>
using namespace std;
int main()
{
    setlocale(LC_ALL, "Russian");
    int n, a, k = 0;
    cout << "Введите количество строк (3-9): ";
    cin >> n;
    if (n < 3 || n > 9)
    {
        cout << "Ошибка ввода";
        return 0;
    }
    for (int i = 1; i <= n; i++)
    {
        for (int j = 1; j <= i; j++)
        {
            a = i + j;
            if (a % 2 == 0)
            {
                cout << "X ";
                k = k + 1;
            }
            else
            {
                cout << a << " ";
            }
        }
        cout << endl;
    }
    cout << "Количество символов X: " << k << endl;
    return 0;
}
